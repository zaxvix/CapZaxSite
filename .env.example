# Set these on the server (cPanel > Setup Node.js App > Environment variables). Never commit real values.
NEXT_PUBLIC_SITE_URL=https://capzax.com
# Contact form mail (same kind of settings as the Zaxvix site). SMTP_USER should be the capzax@zaxvix.com mailbox.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=capzax@zaxvix.com
SMTP_PASSWORD=
# Where messages from the form are delivered (defaults to SMTP_USER) and the visible sender name.
CONTACT_TO_EMAIL=capzax@zaxvix.com
MAIL_FROM_NAME=Capzax Website
